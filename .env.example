# Sherlock operator boundary.
SHERLOCK_MISSION_SIGNING_SECRET=replace-with-at-least-32-random-characters
SHERLOCK_API_KEY=replace-with-at-least-24-random-characters

# PRIMARY LOOKUP ENGINE — EmailOSINT.
# Public/no-key mode can be used for the provider's free unauthenticated tier.
# When EMAILOSINT_API_KEY is set, /api/v1/lookup/email requires SHERLOCK_API_KEY
# so a public Sherlock deployment cannot burn the provider quota.
EMAILOSINT_ENDPOINT=https://api.emailosint.org/v1/lookup/email
EMAILOSINT_API_KEY=
EMAILOSINT_AUTH_HEADER=Authorization
EMAILOSINT_AUTH_SCHEME=Bearer
EMAILOSINT_TIMEOUT_SECONDS=30

# SHERLOCK MAX V2 — optional enrichments.
# HIBP is required only for HIBP exposure checks and PHONE-backed lookup.
HIBP_API_KEY=
# These tokens are optional; without them Sherlock uses the providers' public limits.
GRAVATAR_API_KEY=
GITHUB_TOKEN=
GITLAB_TOKEN=

# SECONDARY AGENT / MISSION LAYER — OSA Execution Force.
OSA_ENGINE_URL=http://127.0.0.1:8643
OSA_ACTIONS_API_KEY=replace-with-the-engine-api-key
OSA_ENGINE_COMMIT_SHA=f365360383511fea13cd3f7af36ecbbc720ce38d

# Local runtime defaults. Cloud Run injects PORT.
SHERLOCK_HOST=127.0.0.1
SHERLOCK_PORT=8787
SHERLOCK_DATABASE_PATH=./data/sherlock-osa.db
SHERLOCK_EVIDENCE_PATH=./data/evidence.jsonl
SHERLOCK_ENGINE_TIMEOUT_SECONDS=15
